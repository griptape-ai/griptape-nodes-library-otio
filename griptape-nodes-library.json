{
    "name": "Griptape Nodes OpenTimelineIO Library",
    "library_schema_version": "0.14.0",
    "metadata": {
        "author": "Griptape",
        "description": "Turn a Fountain script into an OpenTimelineIO timeline. Default clip lengths come from the dialogue, and a timeline widget lets you adjust the timing before writing the OTIO.",
        "library_version": "0.1.0",
        "engine_version": "0.104.0",
        "tags": [
            "Griptape",
            "OpenTimelineIO",
            "Editorial",
            "Script"
        ],
        "dependencies": {
            "pip_dependencies": [
                "OpenTimelineIO>=0.17.0",
                "Pillow>=10.0.0",
                "static-ffmpeg>=2.5"
            ]
        }
    },
    "widgets": [
        {
            "name": "TimelineEditor",
            "path": "otio_nodes/widgets/TimelineEditor/TimelineEditor.js",
            "description": "NLE-style timeline for shots, dialogue, SFX and audio: move, trim, split, snap and ripple clips."
        }
    ],
    "categories": [
        {
            "timeline": {
                "color": "border-amber-500",
                "title": "Timeline",
                "description": "Nodes for scripts, timelines and OpenTimelineIO files",
                "icon": "GanttChart"
            }
        }
    ],
    "nodes": [
        {
            "class_name": "LoadFountainScript",
            "file_path": "otio_nodes/load_fountain_script.py",
            "metadata": {
                "category": "timeline",
                "description": "Read a Fountain screenplay and break it into scenes, action, dialogue and transitions.",
                "display_name": "Load Fountain Script",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "ScriptToTimeline",
            "file_path": "otio_nodes/script_to_timeline.py",
            "metadata": {
                "category": "timeline",
                "description": "Turn a parsed script into a timeline of shots and sequences, with lengths from the dialogue.",
                "display_name": "Script to Timeline",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "SaveOTIO",
            "file_path": "otio_nodes/save_otio.py",
            "metadata": {
                "category": "timeline",
                "description": "Save a timeline as an OpenTimelineIO (.otio) file.",
                "display_name": "Save OTIO",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "TimelineToMovie",
            "file_path": "otio_nodes/timeline_to_movie.py",
            "metadata": {
                "category": "timeline",
                "description": "Render a timeline to a movie with sound.",
                "display_name": "Timeline to Movie",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "LoadOTIO",
            "file_path": "otio_nodes/load_otio.py",
            "metadata": {
                "category": "timeline",
                "description": "Load an OpenTimelineIO (.otio) file into an editable timeline.",
                "display_name": "Load OTIO",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "TimelineEditor",
            "file_path": "otio_nodes/timeline_editor.py",
            "metadata": {
                "category": "timeline",
                "description": "Edit a timeline's shots, dialogue and sound clips on a timeline widget.",
                "display_name": "Timeline Editor",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        },
        {
            "class_name": "TimelineToFountain",
            "file_path": "otio_nodes/timeline_to_fountain.py",
            "metadata": {
                "category": "timeline",
                "description": "Turn a timeline back into a Fountain script, with edits carried over.",
                "display_name": "Timeline to Fountain",
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "BETA"
                    }
                ]
            }
        }
    ],
    "workflow_nodes": [
        {
            "node_type": "Script2OTIONode",
            "workflow_path": "preconfigured_workflows/script_to_otio.py",
            "metadata": {
                "category": "Preconfigured",
                "description": "Convert a Fountain script into an OpenTimelineIO (.otio) timeline.",
                "display_name": "Script to OTIO",
                "group": "convert"
            }
        },
        {
            "node_type": "OTIO2ScriptNode",
            "workflow_path": "preconfigured_workflows/otio_to_script.py",
            "metadata": {
                "category": "Preconfigured",
                "description": "Convert an OpenTimelineIO (.otio) timeline back into a Fountain script.",
                "display_name": "OTIO to Script",
                "group": "convert"
            }
        }
    ]
}
